# PostgreSQL (Internal)
POSTGRES_USER=marketsphere
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=marketsphere
DATABASE_URL=postgresql://marketsphere:changeme_local_only@postgres:5432/marketsphere?schema=public

# Redis (Internal)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Express API
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Authentication (replace in non-local environments)
JWT_ACCESS_SECRET=local_dev_access_secret_change_me
JWT_REFRESH_SECRET=local_dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Local Demo Seed Password (used only by prisma/seed.ts in local/dev)
DEMO_SEED_PASSWORD=DemoPass!2026

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PYTHON_ENGINE_URL=http://localhost:8000

# Python FastAPI Engine
PYTHON_ENGINE_PORT=8000
PYTHON_ENV=development
