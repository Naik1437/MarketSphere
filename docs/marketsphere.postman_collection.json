{
  "info": {
    "name": "MarketSphere API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "apiUrl", "value": "http://localhost:4000" },
    { "key": "pythonUrl", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "API Health",
      "request": { "method": "GET", "url": "{{apiUrl}}/health" }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{apiUrl}}/api/v1/auth/login",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"customer1@marketsphere.local\",\"password\":\"DemoPass!2026\"}"
        }
      }
    },
    {
      "name": "List Products",
      "request": { "method": "GET", "url": "{{apiUrl}}/api/v1/products" }
    },
    {
      "name": "Get Recommendations (FastAPI)",
      "request": {
        "method": "POST",
        "url": "{{pythonUrl}}/api/v1/recommendations",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"limit\":4}" }
      }
    },
    { "name": "Inventory SKUs", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/inventory/skus" } },
    { "name": "Customer Cart", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/cart" } },
    { "name": "Checkout", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/api/v1/orders/checkout", "body": { "mode": "raw", "raw": "{\"warehouseId\":\"<warehouse-id>\",\"idempotencyKey\":\"postman-checkout-001\",\"items\":[{\"skuId\":\"<sku-id>\",\"quantity\":1}]}" } } },
    { "name": "Order List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/orders" } },
    { "name": "Inventory Adjustment", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/api/v1/inventory/adjust", "body": { "mode": "raw", "raw": "{\"skuId\":\"<sku-id>\",\"warehouseId\":\"<warehouse-id>\",\"quantityDelta\":10,\"movementType\":\"RESTOCK\",\"idempotencyKey\":\"postman-restock-001\"}" } } },
    { "name": "Payment Webhook", "request": { "method": "POST", "header": [{ "key": "x-webhook-signature", "value": "<hmac-sha256>" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/api/v1/webhooks/payment", "body": { "mode": "raw", "raw": "{\"eventId\":\"evt-postman-001\",\"providerPaymentId\":\"<provider-payment-id>\",\"eventType\":\"payment.captured\"}" } } },
    { "name": "Shipping Webhook", "request": { "method": "POST", "header": [{ "key": "x-webhook-signature", "value": "<hmac-sha256>" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/api/v1/webhooks/shipping", "body": { "mode": "raw", "raw": "{\"eventId\":\"evt-postman-ship-001\",\"trackingNumber\":\"<tracking-number>\",\"eventType\":\"shipment.in_transit\"}" } } },
    { "name": "Python Pricing", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{pythonUrl}}/api/v1/pricing/calculate", "body": { "mode": "raw", "raw": "{\"items\":[{\"sku_code\":\"DEMO-001\",\"unit_price\":100,\"quantity\":2}]}" } } },
    { "name": "Catalog Normalize", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{pythonUrl}}/api/v1/catalog/normalize", "body": { "mode": "raw", "raw": "{\"rows\":[{\"sku_code\":\" demo-001 \",\"name\":\"Demo Item\",\"category\":\"home\",\"price\":100}]}" } } },
    { "name": "Auth Me", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/auth/me" } },
    { "name": "Product Detail", "request": { "method": "GET", "url": "{{apiUrl}}/api/v1/products/<product-id>" } },
    { "name": "Create Product", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/api/v1/products", "body": { "mode": "raw", "raw": "{\"name\":\"Postman Product\",\"description\":\"Contract example\",\"category\":\"demo\"}" } } },
    { "name": "Update Product", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/api/v1/products/<product-id>", "body": { "mode": "raw", "raw": "{\"name\":\"Updated Product\"}" } } },
    { "name": "Cart Add Item", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/api/v1/cart/items", "body": { "mode": "raw", "raw": "{\"skuId\":\"<sku-id>\",\"quantity\":1}" } } },
    { "name": "Cart Remove Item", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/cart/items/<sku-id>" } },
    { "name": "Order Detail", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/orders/<order-id>" } },
    { "name": "Order Status", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/api/v1/orders/<order-id>/status", "body": { "mode": "raw", "raw": "{\"status\":\"CONFIRMED\"}" } } },
    { "name": "Create Shipment", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/api/v1/orders/<order-id>/shipments", "body": { "mode": "raw", "raw": "{\"warehouseId\":\"<warehouse-id>\",\"carrier\":\"local-stub\"}" } } },
    { "name": "Shipment Status", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/api/v1/orders/shipments/<shipment-id>/status", "body": { "mode": "raw", "raw": "{\"status\":\"IN_TRANSIT\"}" } } },
    { "name": "Return Request", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/api/v1/orders/<order-id>/returns", "body": { "mode": "raw", "raw": "{\"reason\":\"Example\"}" } } },
    { "name": "Refund Payment", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{apiUrl}}/api/v1/payments/<payment-id>/refunds", "body": { "mode": "raw", "raw": "{\"amount\":\"10.00\",\"idempotencyKey\":\"postman-refund-001\"}" } } },
    { "name": "Returns", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/returns" } },
    { "name": "Disputes", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/disputes" } },
    { "name": "Promotions", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/promotions" } },
    { "name": "Admin Overview", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/admin/overview" } },
    { "name": "Seller Scope", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/auth/sellers/<seller-id>/scope" } },
    { "name": "Metrics", "request": { "method": "GET", "url": "{{apiUrl}}/metrics" } },
    { "name": "Refresh", "request": { "method": "POST", "url": "{{apiUrl}}/api/v1/auth/refresh", "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshToken}}\"}" } } },
    { "name": "Logout", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/auth/logout" } },
    { "name": "Sellers", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/sellers" } },
    { "name": "Seller Onboard", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/sellers/onboard" } },
    { "name": "Seller Status", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/sellers/<seller-id>/status" } },
    { "name": "Product Recommendations", "request": { "method": "GET", "url": "{{apiUrl}}/api/v1/products/recommendations" } },
    { "name": "Add SKU", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/products/<product-id>/skus" } },
    { "name": "My Products", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/products/mine" } },
    { "name": "SKU Detail", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/products/skus/<sku-id>" } },
    { "name": "Order Shipment", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/orders/<order-id>/shipments" } },
    { "name": "Shipment Transition", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/orders/shipments/<shipment-id>/status" } },
    { "name": "Refund", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/payments/<payment-id>/refunds" } },
    { "name": "Generate Settlements", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/settlements/generate" } },
    { "name": "Admin Check", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/auth/admin-check" } },
    { "name": "Warehouse Check", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/auth/warehouse-check" } },
    { "name": "Support Check", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/auth/support-check" } },
    { "name": "Customer Scope", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/auth/customers/<customer-id>/scope" } },
    { "name": "Seller Detail", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/sellers/<seller-id>" } },
    { "name": "Seller Settlements", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/sellers/<seller-id>/settlements" } },
    { "name": "Warehouse List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/inventory/warehouses" } },
    { "name": "Inventory Detail", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/inventory/<sku-id>" } },
    { "name": "Cart Remove", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/cart/items/<sku-id>" } },
    { "name": "Order Detail", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/orders/<order-id>" } },
    { "name": "Order Transition", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/orders/<order-id>/status" } },
    { "name": "Order Return", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/orders/<order-id>/returns" } },
    { "name": "Return Transition", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/returns/<return-id>/status" } },
    { "name": "Order Dispute", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/orders/<order-id>/disputes" } },
    { "name": "Dispute Transition", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/disputes/<dispute-id>/status" } },
    { "name": "Recommendations", "request": { "method": "GET", "url": "{{pythonUrl}}/api/v1/recommendations" } },
    { "name": "Update SKU", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/products/skus/<sku-id>" } },
    { "name": "Create Promotion", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{apiUrl}}/api/v1/promotions" } }
  ]
}
