{
  "openapi": "3.0.3",
  "info": {
    "title": "MarketSphere API",
    "version": "1.0.0",
    "description": "Multi-Vendor Commerce, Inventory & Order Platform API"
  },
  "servers": [
    { "url": "http://localhost:4000", "description": "Core Express API" },
    { "url": "http://localhost:8000", "description": "Python FastAPI Engine" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "string" } } },
      "Order": { "type": "object", "properties": { "id": { "type": "string" }, "orderNumber": { "type": "string" }, "status": { "type": "string" }, "totalAmount": { "type": "string" } } },
      "Product": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "category": { "type": "string" }, "status": { "type": "string" } } },
      "CheckoutRequest": { "type": "object", "required": ["warehouseId", "idempotencyKey", "items"], "properties": { "warehouseId": { "type": "string" }, "idempotencyKey": { "type": "string" }, "promotionCode": { "type": "string" }, "items": { "type": "array", "items": { "type": "object", "required": ["skuId", "quantity"], "properties": { "skuId": { "type": "string" }, "quantity": { "type": "integer", "minimum": 1 } } } } } },
      "RecommendationRequest": { "type": "object", "properties": { "user_id": { "type": "string" }, "viewed_categories": { "type": "array", "items": { "type": "string" } }, "purchased_skus": { "type": "array", "items": { "type": "string" } }, "catalog": { "type": "array", "items": { "type": "object" } }, "limit": { "type": "integer", "minimum": 1, "maximum": 20 } } }
    },
    "parameters": {
      "sellerId": { "name": "sellerId", "in": "path", "required": true, "schema": { "type": "string" } },
      "productId": { "name": "productId", "in": "path", "required": true, "schema": { "type": "string" } },
      "page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
      "limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50 } }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health": { "get": { "summary": "API Health & DB/Redis Readiness", "responses": { "200": { "description": "Healthy" } } } },
    "/api/v1/auth/login": { "post": { "summary": "Login with email and password", "responses": { "200": { "description": "JWT access & refresh tokens" } } } },
    "/api/v1/auth/refresh": { "post": { "summary": "Rotate refresh token", "responses": { "200": { "description": "New token pair" } } } },
    "/api/v1/auth/logout": { "post": { "summary": "Revoke refresh token", "responses": { "200": { "description": "Logged out" } } } },
    "/api/v1/auth/me": { "get": { "summary": "Current user profile", "responses": { "200": { "description": "User profile" } } } },
    "/api/v1/sellers": { "get": { "summary": "List sellers (Admin)", "responses": { "200": { "description": "Seller list" } } } },
    "/api/v1/sellers/onboard": { "post": { "summary": "Onboard seller", "responses": { "201": { "description": "Seller created" } } } },
    "/api/v1/sellers/{sellerId}/status": { "patch": { "summary": "Approve/suspend seller (Admin)", "responses": { "200": { "description": "Updated" } } } },
    "/api/v1/products": {
      "get": { "summary": "Search & paginate active products", "responses": { "200": { "description": "Product list" } } },
      "post": { "summary": "Create product (Seller)", "responses": { "201": { "description": "Created" } } }
    },
    "/api/v1/products/recommendations": {
      "get": { "summary": "DB-backed product recommendations via Python engine", "responses": { "200": { "description": "Recommendations" } } }
    },
    "/api/v1/products/{productId}/skus": { "post": { "summary": "Add SKU to product", "responses": { "201": { "description": "SKU created" } } } },
    "/api/v1/inventory/adjust": { "post": { "summary": "Adjust warehouse inventory", "responses": { "200": { "description": "Adjusted" } } } },
    "/api/v1/cart": { "get": { "summary": "Get customer cart", "responses": { "200": { "description": "Cart" } } } },
    "/api/v1/cart/items": { "post": { "summary": "Add/update cart item", "responses": { "200": { "description": "Updated" } } } },
    "/api/v1/orders/checkout": { "post": { "summary": "Transactional checkout & stock reservation", "responses": { "201": { "description": "Order confirmed" } } } },
    "/api/v1/orders/{orderId}/shipments": { "post": { "summary": "Create shipment", "responses": { "201": { "description": "Shipment created" } } } },
    "/api/v1/orders/shipments/{shipmentId}/status": { "patch": { "summary": "Update shipment status", "responses": { "200": { "description": "Updated" } } } },
    "/api/v1/payments/{paymentId}/refunds": { "post": { "summary": "Idempotent refund", "responses": { "201": { "description": "Refunded" } } } },
    "/api/v1/settlements/generate": { "post": { "summary": "Generate seller settlement (Admin)", "responses": { "201": { "description": "Settlement created" } } } },
    "/api/v1/webhooks/payment": { "post": { "summary": "Signed payment webhook", "responses": { "200": { "description": "Processed or deduplicated" } } } },
    "/api/v1/webhooks/shipping": { "post": { "summary": "Signed shipping webhook", "responses": { "200": { "description": "Processed or deduplicated" } } } },
    "/api/v1/pricing/calculate": { "post": { "summary": "Python deterministic pricing & commission", "responses": { "200": { "description": "Calculated" } } } },
    "/api/v1/catalog/normalize": { "post": { "summary": "Python bulk catalog normalization", "responses": { "200": { "description": "Normalized" } } } },
    "/api/v1/recommendations": { "get": { "security": [], "summary": "Cold-start recommendations", "responses": { "200": { "description": "Recommendations" } } }, "post": { "security": [], "summary": "FastAPI product recommendations", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecommendationRequest" } } } }, "responses": { "200": { "description": "Recommendations" } } } },
    "/metrics": { "get": { "security": [], "summary": "API metrics", "responses": { "200": { "description": "Metrics" } } } },
    "/api/v1/auth/admin-check": { "get": { "summary": "Admin authorization check", "responses": { "200": { "description": "Allowed" }, "403": { "description": "Forbidden" } } } },
    "/api/v1/auth/warehouse-check": { "get": { "summary": "Warehouse authorization check", "responses": { "200": { "description": "Allowed" } } } },
    "/api/v1/auth/support-check": { "get": { "summary": "Support authorization check", "responses": { "200": { "description": "Allowed" } } } },
    "/api/v1/auth/sellers/{sellerId}/scope": { "get": { "summary": "Seller ownership scope", "parameters": [{ "$ref": "#/components/parameters/sellerId" }], "responses": { "200": { "description": "Allowed" } } } },
    "/api/v1/auth/customers/{customerId}/scope": { "get": { "summary": "Customer ownership scope", "parameters": [{ "name": "customerId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Allowed" } } } },
    "/api/v1/products/mine": { "get": { "summary": "Seller catalog", "responses": { "200": { "description": "Products" } } } },
    "/api/v1/products/{productId}": { "get": { "security": [], "summary": "Product detail", "parameters": [{ "$ref": "#/components/parameters/productId" }], "responses": { "200": { "description": "Product", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } } } } }, "patch": { "summary": "Update product", "responses": { "200": { "description": "Updated" } } } },
    "/api/v1/products/skus/{skuId}": { "patch": { "summary": "Update SKU", "responses": { "200": { "description": "Updated" } } } },
    "/api/v1/inventory/warehouses": { "get": { "summary": "List warehouses", "responses": { "200": { "description": "Warehouses" } } } },
    "/api/v1/inventory/skus": { "get": { "summary": "Search SKUs", "responses": { "200": { "description": "SKUs" } } } },
    "/api/v1/inventory/{skuId}": { "get": { "summary": "SKU inventory", "responses": { "200": { "description": "Inventory" } } } },
    "/api/v1/cart/items/{skuId}": { "delete": { "summary": "Remove cart item", "responses": { "200": { "description": "Removed" } } } },
    "/api/v1/orders": { "get": { "summary": "Scoped order list", "responses": { "200": { "description": "Orders" } } } },
    "/api/v1/orders/{orderId}": { "get": { "summary": "Scoped order detail", "responses": { "200": { "description": "Order", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } } } } } },
    "/api/v1/orders/{orderId}/status": { "patch": { "summary": "Advance order state", "responses": { "200": { "description": "Updated" }, "409": { "description": "Invalid transition" } } } },
    "/api/v1/orders/{orderId}/returns": { "post": { "summary": "Request return", "responses": { "201": { "description": "Requested" } } } },
    "/api/v1/returns": { "get": { "summary": "List returns", "responses": { "200": { "description": "Returns" } } } },
    "/api/v1/returns/{returnId}/status": { "patch": { "summary": "Update return", "responses": { "200": { "description": "Updated" } } } },
    "/api/v1/orders/{orderId}/disputes": { "post": { "summary": "Raise dispute", "responses": { "201": { "description": "Opened" } } } },
    "/api/v1/disputes": { "get": { "summary": "List disputes", "responses": { "200": { "description": "Disputes" } } } },
    "/api/v1/disputes/{disputeId}/status": { "patch": { "summary": "Update dispute", "responses": { "200": { "description": "Updated" } } } },
    "/api/v1/promotions": { "get": { "summary": "List promotions", "responses": { "200": { "description": "Promotions" } } }, "post": { "summary": "Create promotion", "responses": { "201": { "description": "Created" } } } },
    "/api/v1/admin/overview": { "get": { "summary": "Admin overview", "responses": { "200": { "description": "Overview" } } } },
    "/api/v1/sellers/{sellerId}": { "get": { "summary": "Seller detail", "parameters": [{ "$ref": "#/components/parameters/sellerId" }], "responses": { "200": { "description": "Seller" } } } },
    "/api/v1/sellers/{sellerId}/settlements": { "get": { "summary": "Seller settlements", "responses": { "200": { "description": "Settlements" } } } }
  }
}
