{
  "name": "marketsphere-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "node --test tests/smoke.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/smoke.test.mjs",
    "e2e:ci": "node e2e/marketplace.mjs && node e2e/gaps.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "playwright": "^1.65.1",
    "postcss": ">=8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "5.8.2"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
